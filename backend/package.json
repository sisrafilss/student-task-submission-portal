{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch ./src/server.ts",
    "seed": "tsx ./src/prisma/seed.ts",
    "build": "esbuild src/serverless.ts --bundle --platform=node --target=node20 --format=esm --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --outfile=api/index.js --external:bcrypt --external:pg-native",
    "postinstall": "prisma generate || exit 0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/config": "^7.10.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.0",
    "express": "^5.0.1",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "tsx": "^4.19.3"
  }
}
